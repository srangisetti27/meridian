# Meridian Pipeline Intelligence — Environment Configuration
# Copy this file to .env and fill in your values
# The app works without these (deterministic mode), but AI narration requires one

# Anthropic Claude API (preferred LLM provider)
# Get your key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API (alternative LLM provider)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Force a specific LLM provider
# Values: anthropic | gemini
# If not set, anthropic is preferred if both keys exist
MERIDIAN_LLM_PROVIDER=anthropic

# Optional: Override the model to use
# Anthropic examples: claude-opus-4-8, claude-sonnet-4-20250514
# Gemini examples: gemini-flash-latest, gemini-pro
MERIDIAN_LLM_MODEL=

# Streamlit configuration (optional)
# Show/hide Streamlit's telemetry opt-out notice
STREAMLIT_LOGGER_LEVEL=info
